from transformers import pipeline 
 
qa_pipeline = pipeline("question-answering") 
 
def ask_question(context, question): 
result = qa_pipeline(question=question, context=context) 
return result['answer'] 
 
context = """ 
Artificial Intelligence is the simulation of human intelligence by 
machines. 
It includes learning, reasoning, and self-correction. 
AI is widely used in healthcare, robotics, and smart cities. 
""" 
question = input("Enter your question: ") 
answer = ask_question(context, question) 
 
print("Answer:", answer) 





from transformers import pipeline 
 
summarizer = pipeline("summarization") 
 
text = input("Enter paragraph:\n") 
 
summary = summarizer(text, do_sample=False) 
 
print("\nOriginal Text:\n", text) 
print("\nSummary:\n", summary[0]['summary_text'])





from transformers import pipeline 
 
generator = pipeline("text-generation", model="gpt2") 
 
prompt = input("Enter incomplete prompt:\n") 
 
result = generator(prompt, max_length=50, num_return_sequences=1) 
 
print("\nCompleted Text:\n", result[0]['generated_text'])





